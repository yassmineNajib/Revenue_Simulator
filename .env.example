# Storeino API Configuration
VITE_STOREINO_API_BASE=https://api-stores.storeino.com

# Development Settings
VITE_APP_ENV=development

# API Credentials (Optional - for auto-population)
# Get these from your Storeino developer dashboard
VITE_STOREINO_CLIENT_ID=your_client_id_here
VITE_STOREINO_CLIENT_SECRET=your_client_secret_here

# Example values (replace with your actual credentials):
# VITE_STOREINO_CLIENT_ID=abc123def456
# VITE_STOREINO_CLIENT_SECRET=xyz789uvw012